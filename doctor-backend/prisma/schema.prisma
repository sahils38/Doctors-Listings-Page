generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Doctor {
  id         Int      @id @default(autoincrement())
  name       String
  specialty  String
  experience Int
  location   String
  consultationFee Int
  createdAt  DateTime @default(now())
   imageUrl        String   
  modeOfConsult   String[] 
  languages       String[] 
}
